{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.zhice.io/schema/project.schema.json",
  "title": "自动化科研图谱项目记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "slug", "repo", "name", "tagline", "url",
    "category", "layers", "license", "stars", "stars_approximate",
    "pushed_at", "snapshot_date", "analyzed_commit", "status",
    "review_status", "featured_order"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "name": {"type": "string", "minLength": 1},
    "tagline": {"type": "string", "minLength": 10},
    "url": {"type": "string", "pattern": "^https://github\\.com/"},
    "category": {"type": "string", "minLength": 1},
    "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "license": {"type": "string", "minLength": 1},
    "stars": {"type": ["integer", "null"], "minimum": 0},
    "stars_approximate": {"type": "boolean"},
    "pushed_at": {"type": "string", "format": "date"},
    "snapshot_date": {"type": "string", "format": "date"},
    "analyzed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["published", "pending", "blocked", "remainder"]},
    "review_status": {"enum": ["draft", "migrated-reviewed", "independently-reviewed"]},
    "featured_order": {"type": "integer", "minimum": 1}
  }
}
